{
  "expo": {
    "name": "StudyShala",
    "slug": "studyshala-mobile",
    "scheme": "studyshala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4F6FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-dev-client",
      [
        "@react-native-google-signin/google-signin"
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow StudyShala to access your photos.",
          "savePhotosPermission": "Allow StudyShala to save photos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studyshala.mobile"
    },
    "android": {
      "allowBackup": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "package": "com.studyshala.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "619c965c-9af6-4aad-9133-c246eeac0eca"
      }
    }
  }
}
