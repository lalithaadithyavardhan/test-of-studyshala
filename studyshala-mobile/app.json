{
  "expo": {
    "name": "StudyShala",
    "slug": "studyshala-mobile",
    "scheme": "studyshala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4F6FB"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-dev-client",
      ["@react-native-google-signin/google-signin"],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow StudyShala to access your photos.",
          "savePhotosPermission": "Allow StudyShala to save photos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studyshala.mobile"
    },
    "android": {
      "package": "com.studyshala.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F4F6FB"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "619c965c-9af6-4aad-9133-c246eeac0eca"
      }
    }
  }
}